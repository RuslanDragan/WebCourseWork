@echo off
chcp 65001 > nul
echo ======================================================================
echo Запуск повного комплексу автоматизованих перевірок та тестів
echo ======================================================================

echo [1/3] Запуск автоматизованих модульних та інтеграційних тестів із вимірюванням покриття...
python -m coverage run --source=src -m pytest -v
if errorlevel 1 (
    echo Помилка виконання тестів pytest!
    exit /b 1
)

echo.
echo Звіт покриття коду тестами:
python -m coverage report -m

echo.
echo [2/3] Контрольна перевірка відтворення запуску з чистого середовища...
python scripts\verify_clean_run.py
if errorlevel 1 (
    echo Помилка перевірки чистого запуску!
    exit /b 1
)

echo.
echo [3/3] Перевірка доступності WCAG 2.2 AA, навантаження та адаптивності інтерфейсу...
python scripts\verify_stage9_quality.py
if errorlevel 1 (
    echo Помилка перевірки якості!
    exit /b 1
)

echo.
echo ======================================================================
echo ВСІ ПЕРЕВІРКИ УСПІШНО ПРОЙДЕНО (100%% PASS)
echo ======================================================================
