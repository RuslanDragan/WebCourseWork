# Приклад конфігурації середовища (без реальних секретів)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=data/auditorium_booking.db
TIMEZONE=Europe/Kyiv
SESSION_COOKIE_NAME=booking_session_id
SESSION_MAX_AGE_SECONDS=28800

# Секрет для підпису CSRF-токенів (HMAC-SHA256). У production задається лише через змінну середовища.
SECRET_KEY=dev-only-insecure-secret-change-me

# Дозволені джерела (Origin) для змінювальних запитів (через кому); порожній список = той самий хост
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Налаштування захисту від перебору паролів (Rate Limiting)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
